# ==========================================================================
# Bean Tradition Event Ordering - Backend environment configuration
# Copy to .env and fill in real values. NEVER commit the real .env file.
# ==========================================================================

# --- Google Sheets ---
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full private key. Keep the \n escapes or wrap in quotes with real newlines.
GOOGLE_PRIVATE_KEY=

# --- Auth / sessions ---
EVENT_ADMIN_PASSWORD=change-me-for-the-event
SESSION_SECRET=generate-a-long-random-string

# --- URLs ---
FRONTEND_URL=https://beantradition.in
BACKEND_URL=https://api.beantradition.in

# --- Meta WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_CONFIRMATION_TEMPLATE=order_confirmation
WHATSAPP_READY_TEMPLATE=order_ready
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Master switch. Production MUST set this to true.
# When false, no real Meta calls are made and a simulated result is logged.
WHATSAPP_SEND_ENABLED=false

# --- Internal webhook (Google Apps Script -> FastAPI) ---
SHEET_WEBHOOK_SECRET=generate-a-long-random-string

# Optional: Apps Script order-number counter web-app URL (LockService based).
# If unset, the backend falls back to a locally-locked counter cell in the sheet.
ORDER_NUMBER_SCRIPT_URL=
ORDER_NUMBER_SCRIPT_SECRET=

# --- Business config (also configurable via the Settings sheet) ---
DEFAULT_COUNTRY_CODE=+91
ORDER_PREFIX=BT
INITIAL_ORDER_STATUS=PREPARING
TRACKING_POLL_INTERVAL_MS=3000
QUEUE_DISPLAY_LIMIT=20
BRAND_NAME=Bean Tradition
EVENT_NAME=Bean Tradition College Event

# --- Runtime ---
ENVIRONMENT=development
ENABLE_DOCS=true
# Comma-separated list of allowed browser origins (production must be explicit).
CORS_ORIGINS=http://localhost:5173
